[Unit]
Description=SOPDS scheduled scanner

[Service]
Type=simple
WorkingDirectory=%h/Projects/sopds
EnvironmentFile=%h/.config/sopds/service.env
ExecStart=%h/Projects/sopds/.venv/bin/python manage.py sopds_scanner run
Restart=on-failure
RestartSec=5
TimeoutStopSec=300
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
