# Copy to .local/container.env (0600); never pass this file as a build argument.
# First smoke uses an IPv4 LAN address, without scheme or port.
SOPDS_PRIVATE_HOST=192.168.88.44
SOPDS_HTTPS_PORT=9443
# Absolute path to a SEPARATE synthetic library, readable by UID/GID 10001.
SOPDS_LIBRARY=/absolute/path/to/sopds/.local/container-library
TIME_ZONE=Europe/Moscow
# Three independent random values (at least 32 characters); empty means fail closed.
SOPDS_SECRET_KEY=
SOPDS_DB_PASSWORD=
POSTGRES_PASSWORD=
